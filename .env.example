# SkillRefine Configuration
# Copy this file to .env and fill in your values

# LLM API Configuration
LLM_API_BASE=https://your-api-endpoint.com/v1
LLM_API_KEY=your-api-key-here

# Model Paths (Windows paths)
PIMS_MODEL_WS_DIR=D:\path\to\PIMS-MODEL\Weight Sample
PIMS_MODEL_GC_DIR=D:\path\to\PIMS-MODEL\Gulf Coast

# Data Paths
DATA_DIR=data
RESULTS_DIR=results
SKILL_LIBRARIES_DIR=skill_libraries
KNOWLEDGE_BASE_DIR=data/PIMS-DOC

# Experiment Settings
MAX_AGENT_STEPS=50
DEFAULT_MODEL=deepseek-pro
TEMPERATURE=0.5
MAX_TOKENS=8192
